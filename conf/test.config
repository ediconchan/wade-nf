/*
    Test profile: bundled example contigs (WADE/Example_contigs) + the pinned
    in-repo wade-data. Proves containers + BLAST + R work end-to-end on tiny data.
    SPEC.md section 14, layer 2.

    Usage:
        nextflow run . -profile test,docker --outdir results
        nextflow run . -profile test,conda  --outdir results
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal GAS dataset to test the wade-nf pipeline'

    input     = "${projectDir}/assets/test_data/samplesheet_gas.csv"
    wade_data = "${projectDir}/wade-data"
    organism  = 'GAS'
    analysis  = 'all'
}

// Tiny data: keep resource ceilings low so it runs anywhere
process {
    resourceLimits = [ cpus: 4, memory: '8.GB', time: '1.h' ]
}
