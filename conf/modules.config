/*
    Per-process publishDir + ext.* config.

    Note on BLAST e-values: the original WADE reads sensitivity from each
    (org,test) reference/blast_evalues.csv, which the ported R honours verbatim
    for parity (SPEC.md section 12). params.blast_evalue_* are exposed for
    documentation/override but the reference file remains authoritative, so we do
    not inject e-values via ext.args here.
*/

process {

    withName: 'MASTERBLASTR' {
        // Per-task FASTAs are collated per organism into a single output_dna.fasta /
        // output_aa.fasta in the subworkflow (matches upstream + avoids same-name
        // publishDir races). So no per-task publish here.
        publishDir = [ enabled: false ]
    }

    withName: 'MLST' {
        publishDir = [ enabled: false ]
    }

    withName: 'EMM' {
        publishDir = [ enabled: false ]
    }

    withName: 'RRNA23S' {
        publishDir = [ enabled: false ]
    }

    withName: 'LABWARE_GAS_AMR' {
        publishDir = [
            path: { "${params.outdir}/GAS" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'LABWARE_GAS_TOXINS' {
        publishDir = [
            path: { "${params.outdir}/GAS" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'LABWARE_GBS_AMR' {
        publishDir = [
            path: { "${params.outdir}/GBS" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'LABWARE_PNEUMO_AMR' {
        publishDir = [
            path: { "${params.outdir}/PNEUMO" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'LABWARE_PNEUMO_VIRULENCE' {
        publishDir = [
            path: { "${params.outdir}/PNEUMO" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'RRNA16S_FORMAT' {
        publishDir = [
            path: { "${params.outdir}/${org}" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }

    withName: 'MLST_SPLIT' {
        publishDir = [
            path: { "${params.outdir}/${org}" },
            mode: params.publish_dir_mode,
            pattern: "LabWareUpload_*.csv"
        ]
    }
}
