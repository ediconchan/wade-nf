/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    wade-nf Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input / output
    input                = null
    outdir               = 'results'
    wade_data            = null

    // Analysis selection
    organism             = null          // GAS | GBS | GONO | PNEUMO (fallback when samplesheet has no organism column)
    analysis             = 'all'

    // BLAST sensitivity (exposed; reference blast_evalues.csv still authoritative per (org,test))
    blast_evalue_contig  = '1e-50'
    blast_evalue_allele  = '1e-98'
    wt_id_threshold      = 10

    // Misc
    publish_dir_mode     = 'copy'
    help                 = false
    version              = false
}

// Container / engine selection lives in profiles
process {
    // default container: single image with R + Bioconductor + BLAST+
    container = 'ghcr.io/phac-nml/wade-nf:dev'
}

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        process.conda           = "${projectDir}/containers/environment.yml"
    }
    docker {
        docker.enabled          = true
        singularity.enabled     = false
        conda.enabled           = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
        conda.enabled           = false
    }
    // Run against the conda env created from the top-level environment.yml
    // (developer env: tools already on PATH). Use when not containerising.
    local_env {
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
    }
    test      { includeConfig 'conf/test.config' }
    test_stub { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

manifest {
    name            = 'wade-nf'
    author          = 'Ported from phac-nml/wade (NML, PHAC)'
    description     = 'Nextflow port of WADE: WGS Analysis and Detection of molecular markers (GAS/GBS/PNEUMO/GONO)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.1.0'
    license         = 'Apache-2.0'
}

// Reporting
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html" }
